<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_bank_info"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//span[@name='order_note']" position="after">
            <t t-set="pml" t-value="doc.preferred_payment_method_line_id" />
            <t t-if="pml">
                <t
                    t-set="is_sepa"
                    t-value="pml.payment_method_id.code == 'sepa_direct_debit'"
                />
                <t
                    t-set="company_bank"
                    t-value="pml.journal_id.bank_account_id"
                />
                <div class="mt-3">
                    <!-- Domiciliación bancaria (SEPA): cuenta del cliente -->
                    <t t-if="is_sepa">
                        <t t-set="partner_bank" t-value="doc.partner_id.bank_ids[:1]" />
                        <t t-if="partner_bank">
                            <strong>Datos bancarios para domiciliación:</strong>
                            <ul class="list-unstyled mb-0">
                                <li t-if="partner_bank.bank_id">
                                    <strong>Banco: </strong>
                                    <span t-out="partner_bank.bank_id.name" />
                                </li>
                                <li>
                                    <strong>Número de cuenta: </strong>
                                    <span t-out="partner_bank.acc_number" />
                                </li>
                                <li t-if="partner_bank.bank_id.bic">
                                    <strong>BIC/SWIFT: </strong>
                                    <span t-out="partner_bank.bank_id.bic" />
                                </li>
                            </ul>
                        </t>
                    </t>
                    <!-- Transferencia bancaria: cuenta de la empresa (del journal vinculado al método de pago) -->
                    <t t-elif="company_bank">
                        <strong>Datos bancarios para transferencia:</strong>
                        <ul class="list-unstyled mb-0">
                            <li t-if="company_bank.bank_id">
                                <strong>Banco: </strong>
                                <span t-out="company_bank.bank_id.name" />
                            </li>
                            <li>
                                <strong>Número de cuenta: </strong>
                                <span t-out="company_bank.acc_number" />
                            </li>
                            <li t-if="company_bank.bank_id.bic">
                                <strong>BIC/SWIFT: </strong>
                                <span t-out="company_bank.bank_id.bic" />
                            </li>
                        </ul>
                    </t>
                    <!-- Efectivo / Tarjeta: solo nombre del método de pago -->
                    <t t-else="">
                        <strong>Método de pago: </strong>
                        <span t-out="pml.name" />
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
